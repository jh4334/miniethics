{
  "name": "miniethics",
  "private": true,
  "version": "1.0.0",
  "description": "AI 윤리 미니게임 월드 - 초등 5~6학년 인공지능 윤리 12차시 교육용 게임 (PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "check:ci": "npm run test:unit && npm run test:e2e -- --project=chromium && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "jsdom": "26.1.0",
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
